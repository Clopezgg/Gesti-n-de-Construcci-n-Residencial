      "reqd": 1,
      "in_list_view": 1,
      "description": "El mapeo pertenece a un entorno SAP concreto — el mismo campo puede mapearse distinto en dos conexiones (p. ej. QA y producción)."
    },
    {
      "fieldname": "nexora_object",
      "label": "Objeto NEXORA",
      "fieldtype": "Data",
      "reqd": 1,
      "in_list_view": 1,
      "description": "El DocType o concepto real de NEXORA que se está mapeando, p. ej. \"NXR Operation\"."
    },
    {
      "fieldname": "sap_object",
      "label": "Objeto SAP",
      "fieldtype": "Data",
      "reqd": 1,
      "in_list_view": 1,
      "description": "El objeto/BAPI/entidad real de SAP correspondiente. NEXORA no asume ningún objeto SAP por defecto."
    },
    {
      "fieldname": "active",
      "label": "Activo",
      "fieldtype": "Check",
      "default": "1",

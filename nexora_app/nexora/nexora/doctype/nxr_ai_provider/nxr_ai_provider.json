{
  "doctype": "DocType",
  "name": "NXR AI Provider",
  "module": "NEXORA",
  "custom": 0,
  "is_submittable": 0,
  "autoname": "hash",
  "allow_rename": 0,
  "track_changes": 1,
  "engine": "InnoDB",
  "field_order": [
    "provider_key",
    "display_name",
    "status",
    "capabilities",
    "priority",
    "idempotency_key",
    "payload_hash",
    "correlation_id"
  ],
  "fields": [
    {
      "fieldname": "provider_key",
      "label": "Clave del proveedor",
      "fieldtype": "Data",
      "reqd": 1,
      "unique": 1,
      "description": "Identificador estable usado por el código (ej. \"openai\", \"local-stub\"). Minúsculas, dígitos, guion o guion bajo."
    },
    {
      "fieldname": "display_name",
      "label": "Nombre visible",
      "fieldtype": "Data",
      "reqd": 1
    },
    {
      "fieldname": "status",
      "label": "Estado",
      "fieldtype": "Select",
      "options": "Active\nInactive\nError\nDisabled",
      "default": "Inactive",
      "reqd": 1
    },
    {
      "fieldname": "capabilities",
      "label": "Capacidades",
      "fieldtype": "Data",
      "reqd": 1,
      "description": "Lista separada por comas: text, vision, audio, embedding."
    },
    {
      "fieldname": "priority",
      "label": "Prioridad",
      "fieldtype": "Int",
      "default": 100,
      "description": "Menor número = mayor prioridad al enrutar entre proveedores activos con la misma capacidad."
    },
    {
      "fieldname": "idempotency_key",
      "label": "Clave de idempotencia",
      "fieldtype": "Data",
      "unique": 1,
      "read_only": 1
    },
    {
      "fieldname": "payload_hash",
      "label": "Huella de payload",
      "fieldtype": "Data",
      "read_only": 1
    },
    {
      "fieldname": "correlation_id",
      "label": "Correlación",
      "fieldtype": "Data",
      "read_only": 1
    }
  ],
  "permissions": [
    {
      "role": "NEXORA Administrator",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 0,
      "report": 1,
      "export": 1
    },
    {
      "role": "NEXORA Finance Manager",
      "read": 1,
      "write": 1,
      "create": 0,
      "delete": 0,
      "report": 1,
      "export": 1
    },
    {
      "role": "NEXORA Auditor",
      "read": 1,
      "write": 0,
      "create": 0,
      "delete": 0,
      "report": 1,
      "export": 1
    }
  ],
  "actions": [],
  "links": [],
  "states": [],
  "sort_field": "modified",
  "sort_order": "DESC",
  "search_fields": "provider_key,display_name",
  "title_field": "display_name"
}

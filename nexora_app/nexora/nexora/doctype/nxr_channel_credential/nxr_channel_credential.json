{
  "doctype": "DocType",
  "name": "NXR Channel Credential",
  "module": "NEXORA",
  "custom": 0,
  "is_submittable": 0,
  "autoname": "hash",
  "allow_rename": 0,
  "track_changes": 1,
  "engine": "InnoDB",
  "field_order": [
    "channel",
    "status",
    "app_id",
    "app_secret",
    "access_token",
    "phone_number_id",
    "waba_id",
    "display_phone_number",
    "verify_token",
    "last_test_at",
    "last_test_result",
    "connected_by",
    "connected_at",
    "idempotency_key",
    "payload_hash",
    "correlation_id"
  ],
  "fields": [
    {
      "fieldname": "channel",
      "label": "Canal",
      "fieldtype": "Select",
      "options": "WhatsApp",
      "default": "WhatsApp",
      "reqd": 1,
      "unique": 1,
      "in_list_view": 1,
      "description": "Único por canal: solo una cuenta de WhatsApp Business conectada a la vez en esta primera versión."
    },
    {
      "fieldname": "status",
      "label": "Estado",
      "fieldtype": "Select",
      "options": "Inactive\nActive",
      "default": "Inactive",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "app_id",
      "label": "App ID de Meta",
      "fieldtype": "Data",
      "reqd": 1
    },
    {
      "fieldname": "app_secret",
      "label": "App Secret",
      "fieldtype": "Password",
      "reqd": 1,
      "description": "Cifrado en reposo (Password nativo de Frappe). Se usa para verificar la firma HMAC-SHA256 (X-Hub-Signature-256) de cada webhook entrante — nunca se expone en listados, logs ni auditoría."
    },
    {
      "fieldname": "access_token",
      "label": "Token de acceso",
      "fieldtype": "Password",
      "reqd": 1,
      "description": "Token de acceso de larga duración (System User) de la app de WhatsApp Business Cloud API. Cifrado en reposo."
    },
    {
      "fieldname": "phone_number_id",
      "label": "ID del número de teléfono",
      "fieldtype": "Data",
      "reqd": 1,
      "description": "phone_number_id asignado por Meta al número ya registrado en la app — no el número humano."
    },
    {
      "fieldname": "waba_id",
      "label": "WhatsApp Business Account ID",
      "fieldtype": "Data",
      "reqd": 1
    },
    {
      "fieldname": "display_phone_number",
      "label": "Número visible",
      "fieldtype": "Data",
      "read_only": 1,
      "description": "Confirmado por la propia API de Meta al probar la conexión — nunca escrito a mano."
    },
    {
      "fieldname": "verify_token",
      "label": "Token de verificación del webhook",
      "fieldtype": "Password",
      "reqd": 1,
      "description": "El mismo valor configurado en el panel de Meta para la verificación GET del webhook (hub.verify_token). Cifrado en reposo."
    },
    {
      "fieldname": "last_test_at",
      "label": "Última prueba",
      "fieldtype": "Datetime",
      "read_only": 1
    },
    {
      "fieldname": "last_test_result",
      "label": "Resultado de la última prueba",
      "fieldtype": "Data",
      "read_only": 1
    },
    {
      "fieldname": "connected_by",
      "label": "Conectado por",
      "fieldtype": "Link",
      "options": "User",
      "read_only": 1
    },
    {
      "fieldname": "connected_at",
      "label": "Conectado el",
      "fieldtype": "Datetime",
      "read_only": 1
    },
    {
      "fieldname": "idempotency_key",
      "label": "Clave de idempotencia",
      "fieldtype": "Data",
      "read_only": 1
    },
    {
      "fieldname": "payload_hash",
      "label": "Huella de payload",
      "fieldtype": "Data",
      "read_only": 1,
      "description": "Huella de un resumen redactado del payload recibido. Nunca se calcula sobre ninguna credencial en texto plano."
    },
    {
      "fieldname": "correlation_id",
      "label": "Correlación",
      "fieldtype": "Data",
      "read_only": 1
    }
  ],
  "permissions": [
    {
      "role": "NEXORA Administrator",
      "read": 1,
      "write": 0,
      "create": 0,
      "delete": 0,
      "report": 0,
      "export": 0
    }
  ],
  "actions": [],
  "links": [],
  "states": [],
  "sort_field": "modified",
  "sort_order": "DESC",
  "search_fields": "channel,status",
  "title_field": "channel"
}

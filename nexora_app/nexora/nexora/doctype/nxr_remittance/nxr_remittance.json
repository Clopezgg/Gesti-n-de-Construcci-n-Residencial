{
  "doctype": "DocType",
  "name": "NXR Remittance",
  "module": "NEXORA",
  "custom": 0,
  "is_submittable": 0,
  "autoname": "field:remittance_code",
  "allow_rename": 0,
  "track_changes": 1,
  "engine": "InnoDB",
  "field_order": [
    "remittance_code",
    "project",
    "remittance_date",
    "currency",
    "total_original_amount",
    "exchange_rate",
    "total_amount_hnl",
    "origin_or_sender",
    "custodian",
    "institution",

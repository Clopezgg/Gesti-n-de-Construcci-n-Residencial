ERPNEXT_VERSION=v15.117.0
SITE_NAME=nexora.local
DB_NAME=_nexora
DB_PASSWORD=change-me-db-password
DB_ROOT_PASSWORD=change-me-db-root-password
ADMIN_PASSWORD=change-me-admin-password
FRAPPE_ENCRYPTION_KEY=change-me-32-plus-char-key
FRAPPE_EXTERNAL_URL=https://nexora.example.com
TZ=America/Tegucigalpa
GUNICORN_WORKERS=2
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=120
BACKUP_LOCAL_HOUR=2
BACKUP_RETENTION_DAYS=14
BACKUP_RUN_ON_START=false
NEXORA_ENVIRONMENT=production
# Hallazgo real: hasta que docker-compose.nexora.yml empezó a exigirla, esta
# variable nunca llegaba al contenedor pese a documentarse aquí desde antes —
# nexora.build_info.get_build_info() siempre respondía "unknown". Poblar con el
# SHA real del commit que se está construyendo (`git rev-parse HEAD` en el
# pipeline de build, no un valor fijo), y verificar contra el sitio real con
# `python3 scripts/verify_nexora_deployment.py --base-url https://<host>
# --expected-sha <sha> --authorization "token <api_key>:<api_secret>"`.
NEXORA_BUILD_SHA=replace-with-approved-main-sha
NEXORA_SEED_DEMO_DATA=false

# NEXORA Intelligence Platform — credenciales de proveedores de IA (Bloque 3).
# Opcionales: sin ninguna, el subsistema de IA queda con cero proveedores con
# credencial disponible y el resto de NEXORA sigue funcionando igual.
# Variables exclusivamente de servidor; nunca las exponga al cliente ni las
# reemplace por un valor real en este archivo de ejemplo.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
PERPLEXITY_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=
MISTRAL_API_KEY=
COHERE_API_KEY=

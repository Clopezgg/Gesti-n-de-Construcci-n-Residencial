{
  "routes": [
    {
      "domain": "financial",
      "match": ["financial", "fund", "ledger", "account"],
      "agent": "financial-core",
      "handoff_to": ["repo-governance"]
    },
    {
      "domain": "contracts",
      "match": ["contract", "quotation", "supplier"],
      "agent": "contracts-core",
      "handoff_to": ["repo-governance", "ui-public"]
    },
    {
      "domain": "operations",
      "match": ["progress", "inventory", "purchase", "operation", "nexora_operations"],
      "agent": "operations-core",
      "handoff_to": ["repo-governance", "ui-public"]
    },
    {
      "domain": "ui-public",
      "match": ["public", "css", "page", "dashboard"],
      "agent": "ui-public",
      "handoff_to": ["repo-governance"]
    },
    {
      "domain": "workflow-governance",
      "match": [".github/workflows", "ops/agents", "docs"],
      "agent": "repo-governance",
      "handoff_to": []
    }
  ]
}
